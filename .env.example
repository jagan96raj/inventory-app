# Copy to .env at repo root
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory
DATABASE_URL=postgresql+psycopg://inventory:inventory@localhost:5432/inventory

# Database connection pool (Spec v16.0.4). Defaults suit 1–5 concurrent users on one backend process.
# If running multiple uvicorn workers, keep (DB_POOL_SIZE + DB_MAX_OVERFLOW) × workers below Postgres max_connections (100 on Docker image).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Leave empty in dev so Vite proxies /api → backend (avoids CORS). Set only if not using proxy.
VITE_API_URL=

# Authentication (Spec v10)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_HOURS=24
# Production (HTTPS): set true so the session cookie is Secure-only.
COOKIE_SECURE=false
# Production: set true to disable /docs, /redoc, and /openapi.json (Spec v17.3.6).
DISABLE_API_DOCS=false
# Production: comma-separated emails allowed to sign up or log in (Spec v15.1 signup lockdown).
# Example: ALLOWED_EMAILS=jaganraj@rajagro.com,staff@company.com
ALLOWED_EMAILS=jaganraj@rajagro.com
# Set true in production deploys to refuse backend startup when ALLOWED_EMAILS is empty.
REQUIRE_ALLOWED_EMAILS=false

# Comma-separated frontend URLs the browser may use to call this API (CORS).
# Leave empty for local dev defaults (localhost:5173-5175).
# Production example: CORS_ORIGINS=https://inventory.yourdomain.com
CORS_ORIGINS=

# Google Sign-In (optional — for future use)
GOOGLE_CLIENT_ID=

# Password required to void payments, fulfillment, operations, and cash book entries.
# Users may also authorize voids with their own login password. Required for Google-only accounts.
VOID_AUTH_PASSWORD=change-me-void-password

# Login rate limit (Spec v15.5) — after too many wrong passwords, pause login for that email.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Destructive dev scripts (Spec v15.7) — NEVER set true on production.
# Required to run backend/scripts/reset_db.py or clear_transactional_data.py on local dev only.
ALLOW_DESTRUCTIVE_SCRIPTS=false
DESTRUCTIVE_SCRIPT_CONFIRM=

# Public company registration (Spec v17.0.4) — create a NEW company + owner account.
# Default false keeps Raj Agro locked down. Existing staff still use ALLOWED_EMAILS + Users page.
# DO NOT enable on production unless you intentionally allow open tenant signup.
ALLOW_COMPANY_REGISTRATION=false

# Idempotency guard table cleanup (Spec v16.0.3) — technical anti–double-submit cache only.
IDEMPOTENCY_RETENTION_DAYS=90
IDEMPOTENCY_STALE_IN_PROGRESS_HOURS=24

# Daily backup (Spec v16.0.8) — scripts/backup_db.ps1
BACKUP_DIR=D:\InventoryBackups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_TIME=02:00

# In-app backup download (Spec v17.3.19) — docker compose exec pg_dump on this service.
POSTGRES_COMPOSE_SERVICE=db
BACKUP_TIMEOUT_SECONDS=300
